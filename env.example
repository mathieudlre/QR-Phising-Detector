# Copie ce fichier en .env puis remplis les valeurs :
#   cp .env.example .env
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).
# Toutes les clés sont optionnelles : sans clé, la source correspondante est ignorée
# et l'analyse continue avec les règles et le modèle ML.

# --- Réputation d'URL (Phase 7) ---

# Google Safe Browsing (usage non commercial uniquement)
# https://developers.google.com/safe-browsing/reference
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal, API publique : 4 requêtes/minute, 500/jour, usage non commercial
# https://docs.virustotal.com/reference/overview
VIRUSTOTAL_API_KEY=

# abuse.ch (URLhaus) : Auth-Key gratuite sur https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# urlscan.io : https://urlscan.io/docs/api/
URLSCAN_API_KEY=
# Visibilité des scans soumis : private, unlisted ou public
URLSCAN_VISIBILITY=private

# --- Réglages de l'application ---

# Active les appels aux services externes (true/false).
# Laisse à false pour la démo publique afin de ne pas épuiser les quotas.
ENABLE_EXTERNAL_LOOKUPS=false

# Délai maximal par requête externe, en secondes
REQUEST_TIMEOUT_SECONDS=5

# Durée de vie du cache des résultats externes, en heures
CACHE_TTL_HOURS=24

# Taille maximale d'une image envoyée à l'API, en mégaoctets
MAX_UPLOAD_MB=10

# URL de l'API utilisée par l'interface Streamlit (Phase 8)
API_URL=http://localhost:8000
